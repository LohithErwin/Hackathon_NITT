# Copy to .env and fill in ONE provider. Never commit .env.
# LLM_PROVIDER: "gemini" | "openai" | empty = auto-detect from whichever key is set (Gemini first)
LLM_PROVIDER=

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional retrieval tuning (defaults calibrated on the indexed papers)
RAG_MAX_CHUNK_DISTANCE=0.40
RAG_SCOPED_MAX_CHUNK_DISTANCE=0.46
RAG_MAX_FIGURE_DISTANCE=0.42
RAG_MIN_SUMMARY_SIMILARITY=0.55
RAG_COMPARE_MAX_DISTANCE=0.60
RAG_MAX_IMAGES=3
